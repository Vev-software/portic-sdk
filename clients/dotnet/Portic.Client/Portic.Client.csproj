  <ItemGroup>
    <ProjectReference Include="..\..\..\contracts\dotnet\Portic.Sdk\Portic.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
